# ─── Notifications ─────────────────────────────────────────────────────────────
# Email — use an app password, not your main password
# For Gmail: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# Desktop notifications (true/false) — only works when running locally, not in Docker
DESKTOP_NOTIFICATIONS_ENABLED=false  # Only works when running locally (not in Docker)

# ─── Alert Defaults ─────────────────────────────────────────────────────────────
DEFAULT_ALERT_COOLDOWN_MINUTES=60
DEFAULT_REFRESH_INTERVAL_MINUTES=30

# ─── AI Provider (optional) ─────────────────────────────────────────────────────
# Leave AI_API_KEY empty to disable AI features entirely.
# The app works fully without AI configured.

# OpenAI (default)
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o

# Google Gemini:
# AI_PROVIDER=google
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_API_KEY=your-gemini-key
# AI_MODEL=gemini-1.5-pro

# Ollama (free, local):
# AI_PROVIDER=ollama
# AI_BASE_URL=http://host.docker.internal:11434/v1
# AI_API_KEY=ollama
# AI_MODEL=gemma3:latest
